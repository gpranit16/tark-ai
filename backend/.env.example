# ==============================================================================
# TARK AI Backend — Environment Variables Template
# ==============================================================================

# Application Environment ('production' | 'development' | 'test')
APP_ENV=production

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# For Render / Supabase / Neon: paste your cloud connection string here.
# Note: Format can be postgresql:// or postgresql+asyncpg:// (auto-normalized)
DATABASE_URL=postgresql+asyncpg://username:password@your-db-host:5432/tarkai

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 64-char random string in production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# CORS & Frontend Origins
# ------------------------------------------------------------------------------
# Production Frontend URL (e.g., https://tark-ai.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app
# Optional comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# AI LLM Model Providers
# ------------------------------------------------------------------------------
# Primary Groq API Key (Fast & Reasoning Models)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Provider selection ('groq' | 'mistral' | 'gemini')
DEFAULT_PROVIDER=groq
FAST_PROVIDER=groq
FAST_MODEL=qwen/qwen3.6-27b
NORMAL_PROVIDER=groq
NORMAL_MODEL=qwen/qwen3.8-27b
REASONING_PROVIDER=groq
REASONING_MODEL=openai/gpt-oss-120b

# Coding Mode Provider & Model
CODING_PROVIDER=groq
CODING_MODEL=qwen/qwen3.8-27b

# Optional Alternate Providers
MISTRAL_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------------------------
# Web Search & Deep Research
# ------------------------------------------------------------------------------
# Tavily API Key for live web & deep research search queries
TAVILY_API_KEY=tvly-your_tavily_api_key_here
WEB_SEARCH_PROVIDER=duckduckgo
NEWS_PROVIDER=duckduckgo
DEEP_RESEARCH_ENABLED=true

# ------------------------------------------------------------------------------
# Storage Provider (Backblaze B2 or Local)
# ------------------------------------------------------------------------------
# For Production: use 'b2'. For Local Development: use 'local'.
STORAGE_PROVIDER=b2
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_application_key
B2_BUCKET_NAME=tarkai-storage

# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=TARK AI
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# Vector Embeddings, Reranking & CRAG
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MEMORY_ENABLED=true
TOOL_CALLING_ENABLED=true

# ------------------------------------------------------------------------------
# Voice Mode Configuration
# ------------------------------------------------------------------------------
VOICE_STT_PROVIDER=browser
VOICE_TTS_PROVIDER=browser

# ------------------------------------------------------------------------------
# Google Calendar OAuth (Personal OS)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
# Local: http://localhost:8001/api/v1/integrations/google/calendar/callback
# Production: https://tarkai-backend.onrender.com/api/v1/integrations/google/calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/google/calendar/callback


